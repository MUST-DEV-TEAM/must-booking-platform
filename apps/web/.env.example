# Server-side API origin used by Next.js rewrites. Browser requests stay same-origin.
API_URL=http://localhost:3000

# Sentry error tracking / tracing / logging / session replay for apps/web.
# The DSN is safe to expose to the browser (that's what NEXT_PUBLIC_ is for) — it can
# only submit events, not read data. Leave SENTRY_DSN unset to fall back to the same DSN.
NEXT_PUBLIC_SENTRY_DSN=https://a1f1e0e31446cbf5a6a13f44b99ec9c4@o4511925476917248.ingest.de.sentry.io/4511925529608272
SENTRY_DSN=https://a1f1e0e31446cbf5a6a13f44b99ec9c4@o4511925476917248.ingest.de.sentry.io/4511925529608272

# Only needed to upload source maps at build time (readable stack traces in prod).
# Org/project slugs (not the numeric IDs in the DSN) — find them in Sentry's project
# settings. SENTRY_AUTH_TOKEN is a build-time secret; never commit a real value.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
