# HTTP listener port for the local API.
APP_PORT=3000

# Local PostgreSQL runtime role. `must_booking` is reserved for migrations.
DATABASE_URL=postgresql://must_booking_app:must_booking_app_dev@localhost:5432/must_booking?schema=public

# Local PostgreSQL migration owner, used only by `prisma migrate *` via `directUrl`.
MIGRATION_DATABASE_URL=postgresql://must_booking:must_booking_dev@localhost:5432/must_booking?schema=public

# Local Redis service started by `docker compose up -d`.
REDIS_URL=redis://localhost:6379

# Transactional email, delivered through Resend. Use a verified sender address.
RESEND_API_KEY=re_example
# Optional local/test-only Resend-compatible endpoint. Leave unset for Resend production delivery.
RESEND_API_BASE_URL=
MAIL_FROM_EMAIL=MUST Booking <noreply@example.com>

# Public web-app origin used in verification links.
WEB_APP_URL=http://localhost:3001

# AES-256-GCM master key (32 bytes, base64) for tenant-owned integration
# connection credentials at rest (ADR-0026, Milestone 11). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_CREDENTIALS_KEY=replace_with_a_generated_32_byte_base64_key

# Production error tracking and operational alerts. Keep the DSN only in the
# server environment; leave it blank locally when alerts are not wanted.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# One-off internal seed only; never expose these through public signup.
PLATFORM_ADMIN_EMAIL=admin@must.al
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-random-password

# HMAC key for short-lived, session-bound booking quote snapshots.
QUOTE_SIGNING_SECRET=replace-with-a-long-random-secret

# Stripe guest payments. Use test-mode keys locally; the webhook secret is used in Task 4.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_test_webhook_secret

# PokPay guest payments. Keep these server-side only; use staging while this integration is in test mode.
POKPAY_KEY_ID=replace_with_your_staging_key_id
POKPAY_KEY_SECRET=replace_with_your_staging_key_secret
POKPAY_MERCHANT_ID=replace_with_your_staging_merchant_id
POKPAY_WEBHOOK_URL=https://api.example.test/webhooks/pokpay
POKPAY_API_BASE_URL=https://api-staging.pokpay.io

# Cloudflare R2 (object storage for room-type images, ADR-0011). Not boot-required —
# StorageProvider fails per-call, same as the Resend variables above, so these can be
# left unset for local dev/tests, which mock StorageProvider rather than calling R2.
R2_ACCOUNT_ID=r2_example_account_id
R2_ACCESS_KEY_ID=r2_example_access_key_id
R2_SECRET_ACCESS_KEY=r2_example_secret_access_key
R2_BUCKET_NAME=must-booking-media-dev
R2_PUBLIC_BASE_URL=https://media-dev.example.com
