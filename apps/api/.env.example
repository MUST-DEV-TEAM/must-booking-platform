# HTTP listener port for the local API.
APP_PORT=3000

# Local PostgreSQL runtime role. `must_booking` is reserved for migrations.
DATABASE_URL=postgresql://must_booking_app:must_booking_app_dev@localhost:5432/must_booking?schema=public

# Local PostgreSQL migration owner, used only by `prisma migrate *` via `directUrl`.
MIGRATION_DATABASE_URL=postgresql://must_booking:must_booking_dev@localhost:5432/must_booking?schema=public

# Local Redis service started by `docker compose up -d`.
REDIS_URL=redis://localhost:6379

# Transactional email, delivered through Resend. Use a verified sender address.
RESEND_API_KEY=re_example
MAIL_FROM_EMAIL=MUST Booking <noreply@example.com>

# Public web-app origin used in verification links.
WEB_APP_URL=http://localhost:3001

# HMAC key for short-lived, session-bound booking quote snapshots.
QUOTE_SIGNING_SECRET=replace-with-a-long-random-secret

# Cloudflare R2 (object storage for room-type images, ADR-0011). Not boot-required —
# StorageProvider fails per-call, same as the Resend variables above, so these can be
# left unset for local dev/tests, which mock StorageProvider rather than calling R2.
R2_ACCOUNT_ID=r2_example_account_id
R2_ACCESS_KEY_ID=r2_example_access_key_id
R2_SECRET_ACCESS_KEY=r2_example_secret_access_key
R2_BUCKET_NAME=must-booking-media-dev
R2_PUBLIC_BASE_URL=https://media-dev.example.com
