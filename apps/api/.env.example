# HTTP listener port for the local API.
APP_PORT=3000

# Local PostgreSQL runtime role. `must_booking` is reserved for migrations.
DATABASE_URL=postgresql://must_booking_app:must_booking_app_dev@localhost:5432/must_booking?schema=public

# Local PostgreSQL migration owner, used only by `prisma migrate *` via `directUrl`.
MIGRATION_DATABASE_URL=postgresql://must_booking:must_booking_dev@localhost:5432/must_booking?schema=public

# Local Redis service started by `docker compose up -d`.
REDIS_URL=redis://localhost:6379
