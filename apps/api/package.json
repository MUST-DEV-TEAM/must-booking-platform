{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc --project tsconfig.build.json",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed:platform-admin": "node --env-file-if-exists=.env --import=tsx scripts/seed-platform-admin.ts",
    "seed:local-demo": "node --env-file-if-exists=.env --import=tsx scripts/seed-local-demo.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@must/domain-contracts": "workspace:*",
    "@must/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.0",
    "@sentry/node": "^10.70.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.4.0",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.4.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.16.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
