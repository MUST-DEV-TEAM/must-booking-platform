enum IntegrationConnectionKind {
  PAYMENT
  PMS
}

enum IntegrationProvider {
  STRIPE
  POKPAY
  CLOCK_PMS
}

enum IntegrationConnectionStatus {
  PENDING
  CONNECTED
  FAILED
}

// ADR-0026: tenant-owned integration connections (payment gateways & PMS).
// One connection = one set of tenant-supplied credentials for one provider;
// encryptedCredentials is an AES-256-GCM-encrypted JSON blob (IntegrationCredentialCipher),
// shape varies per provider and is never represented in the schema directly.
model IntegrationConnection {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                       @map("tenant_id") @db.Uuid
  kind                 IntegrationConnectionKind
  provider             IntegrationProvider
  name                 String                       @db.VarChar(200)
  encryptedCredentials String                       @map("encrypted_credentials") @db.Text
  status               IntegrationConnectionStatus  @default(PENDING)
  lastTestedAt         DateTime?                    @map("last_tested_at") @db.Timestamptz(6)
  lastTestResult       String?                      @map("last_test_result") @db.VarChar(500)
  // Random, unguessable id used in the public webhook URL path (source brief
  // section 27/29: "random webhook installation ID") — never the internal
  // `id`, so the callback URL doesn't expose or enumerate connection rows.
  webhookPublicId      String                       @unique @default(dbgenerated("gen_random_uuid()")) @map("webhook_public_id") @db.Uuid
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([tenantId, kind])
  @@map("integration_connections")
}

// Join table: which properties have which connections enabled. `kind` is
// denormalized from IntegrationConnection so a partial unique index (see
// migration SQL) can enforce "at most one active PMS connection per property"
// at the database level, not just in application code. PAYMENT connections
// have no such limit — a property may enable several at once.
model PropertyIntegrationConnection {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                    @map("tenant_id") @db.Uuid
  propertyId   String                    @map("property_id") @db.Uuid
  connectionId String                    @map("connection_id") @db.Uuid
  kind         IntegrationConnectionKind
  enabled      Boolean                   @default(true)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, propertyId, connectionId])
  @@index([tenantId, propertyId])
  @@index([tenantId, connectionId])
  @@map("property_integration_connections")
}

enum ClockCatalogEntityType {
  ROOM_TYPE
  ROOM
}

enum ClockSyncStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

// Milestone 11 Task 7 (source brief section 13/14): Clock's catalog is never
// auto-applied to the local room_types/rooms tables. Every synced entity
// lands here as PROPOSED first; an admin explicitly confirms (which creates
// the local entity and links it) or rejects each one.
model ClockCatalogMapping {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  propertyId       String                 @map("property_id") @db.Uuid
  connectionId     String                 @map("connection_id") @db.Uuid
  entityType       ClockCatalogEntityType @map("entity_type")
  localEntityId    String?                @map("local_entity_id") @db.Uuid
  externalEntityId String                 @map("external_entity_id")
  externalParentId String?                @map("external_parent_id")
  externalName     String                 @map("external_name") @db.VarChar(200)
  syncStatus       ClockSyncStatus        @default(PROPOSED) @map("sync_status")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, connectionId, entityType, externalEntityId])
  @@index([tenantId, propertyId, syncStatus])
  @@map("clock_catalog_mappings")
}

enum ManualReviewCategory {
  UNKNOWN_RESULT
  DUPLICATE
  MISSING_MAPPING
  SIMULTANEOUS_CHANGE
  PAYMENT_BOOKING_MISMATCH
  UNKNOWN_STATUS
  SCHEMA_MISMATCH
}

enum ManualReviewStatus {
  OPEN
  RESOLVED
}

// Milestone 11 Task 12 (source brief section 26): every trigger the brief
// lists gets a category here so the schema doesn't need to change as later
// tasks/milestones wire up the triggers that don't have real producing code
// yet (payment sync, full reconciliation) — see the milestone doc for which
// categories this milestone actually raises for real vs. schema-ready-only.
model ManualReviewItem {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  propertyId       String               @map("property_id") @db.Uuid
  connectionId     String?              @map("connection_id") @db.Uuid
  category         ManualReviewCategory
  referenceType    String               @map("reference_type") @db.VarChar(50)
  referenceId      String?              @map("reference_id") @db.VarChar(200)
  message          String               @db.VarChar(1000)
  context          Json?
  status           ManualReviewStatus   @default(OPEN)
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId String?              @map("resolved_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, propertyId, status])
  @@map("manual_review_items")
}

enum ProviderEventStatus {
  RECEIVED
  QUEUED
  HYDRATED
  IGNORED
  FAILED
}

// Milestone 11 Task 11 (source brief section 20/21): every inbound webhook
// notification, stored durably BEFORE the 2xx response and BEFORE any queue
// hand-off, so "did we already see this event" survives a crash/retry.
// Generic "provider_events" naming (not "clock_events") per the brief —
// this table isn't meant to be Clock-specific if another PMS's webhooks
// land here later.
model ProviderEvent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  propertyId    String              @map("property_id") @db.Uuid
  connectionId  String              @map("connection_id") @db.Uuid
  provider      IntegrationProvider
  eventId       String              @map("event_id") @db.VarChar(200)
  eventType     String              @map("event_type") @db.VarChar(200)
  objectId      String?             @map("object_id") @db.VarChar(200)
  payloadHash   String              @map("payload_hash") @db.VarChar(64)
  rawPayload    Json                @map("raw_payload")
  status        ProviderEventStatus @default(RECEIVED)
  attempts      Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([connectionId, eventId])
  @@index([tenantId, propertyId, status])
  @@map("provider_events")
}

model Amenity {
