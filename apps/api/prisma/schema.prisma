generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

enum TenantMembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum PropertyRoleTemplateKind {
  BUILT_IN
  CUSTOM
}

enum BookingStatus {
  DRAFT
  QUOTED
  INVENTORY_REVALIDATING
  PAYMENT_PENDING
  PAYMENT_NOT_REQUIRED
  PMS_CREATION_PENDING
  PMS_CONFIRMATION_PENDING
  CONFIRMED
  AVAILABILITY_FAILED
  PAYMENT_FAILED
  PMS_UNKNOWN_RESULT
  PMS_REJECTED
  MANUAL_REVIEW
  CANCELLED
  EXPIRED
}

enum BookingPaymentMethod {
  STRIPE_CHECKOUT
  POKPAY
  PAY_AT_HOTEL
  FREE
}

enum PaymentKind {
  CHARGE
  REFUND
}

enum AmenityIcon {
  WIFI
  BREAKFAST
  POOL
  PARKING
  AIR_CONDITIONING
  BEACH
  CABLE_CHANNELS
  REFRIGERATOR
  FLAT_SCREEN_TV
  LINEN
  TELEPHONE
  DRYER
  STREAMING
  SAFETY_DEPOSIT_BOX
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum AuditActorType {
  TENANT_USER
  PLATFORM_ADMIN
}

model Organization {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String             @db.VarChar(200)
  status       OrganizationStatus @default(ACTIVE)
  planId       String             @default("00000000-0000-0000-0000-000000000001") @map("plan_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  properties   Property[]
  memberships  TenantMembership[]
  capabilities Capability[]

  @@map("organizations")
}

model Plan {
  id                           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String         @unique @db.VarChar(100)
  maxProperties                Int            @map("max_properties")
  maxStaffSeats                Int            @map("max_staff_seats")
  pmsEnabled                   Boolean        @default(false) @map("pms_enabled")
  maxPmsConnectionsPerProperty Int            @map("max_pms_connections_per_property")
  createdAt                    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizations                Organization[]

  @@map("plans")
}

model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String             @unique @db.VarChar(320)
  passwordHash      String?            @map("password_hash")
  emailVerifiedAt   DateTime?          @map("email_verified_at") @db.Timestamptz(6)
  isPlatformAdmin   Boolean            @default(false) @map("is_platform_admin")
  isAutoProvisioned Boolean            @default(false) @map("is_auto_provisioned")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships       TenantMembership[]

  @@map("users")
}

model Property {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  name              String                    @db.VarChar(200)
  slug              String                    @db.VarChar(100)
  address           String?                   @db.VarChar(500)
  timezone          String?                   @db.VarChar(100)
  bookingMode       PropertyBookingMode       @default(ROOM_TYPE_ONLY) @map("booking_mode")
  minStayNights     Int?                      @map("min_stay_nights")
  maxStayNights     Int?                      @map("max_stay_nights")
  checkInTime       String?                   @map("check_in_time")
  checkOutTime      String?                   @map("check_out_time")
  rules             String?                   @db.Text
  advanceBookingDays Int?                     @map("advance_booking_days")
  freeCancellationDaysBeforeArrival Int       @default(21) @map("free_cancellation_days_before_arrival")
  publicWebsiteOrigin String?                 @map("public_website_origin") @db.VarChar(500)
  wordpressConnectedAt DateTime?              @map("wordpress_connected_at") @db.Timestamptz(6)
  stripeEnabled     Boolean                   @default(false) @map("stripe_enabled")
  pokpayEnabled     Boolean                   @default(false) @map("pokpay_enabled")
  payAtHotelEnabled Boolean                   @default(false) @map("pay_at_hotel_enabled")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleTemplates     PropertyRoleTemplate[]
  staffAssignments  PropertyStaffAssignment[]
  roomTypes         RoomType[]
  rooms             Room[]
  roomAvailability  RoomAvailability[]
  inventoryUnits    InventoryUnit[]
  ratePlans         RatePlan[]
  rateRules         RateRule[]
  roomPriceOverrides RoomPriceOverride[]
  bookings          Booking[]
  notifications     Notification[]
  payments          Payment[]
  paymentProviderSessions PaymentProviderSession[]
  amenities         Amenity[]
  roomTypeAmenities RoomTypeAmenity[]
  roomAmenities     RoomAmenity[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("properties")
}

enum PropertyBookingMode {
  ROOM_TYPE_ONLY
  INDIVIDUAL_ROOM_ONLY
  MIXED
}

model TenantMembership {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  userId            String                    @map("user_id") @db.Uuid
  role              TenantMembershipRole
  isAutoProvisioned Boolean                   @default(false) @map("is_auto_provisioned")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  staffAssignments  PropertyStaffAssignment[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Capability {
  id                       String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String                           @map("tenant_id") @db.Uuid
  key                      String                           @db.VarChar(100)
  description              String?                          @db.VarChar(500)
  createdAt                DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleTemplateCapabilities PropertyRoleTemplateCapability[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("capabilities")
}

model PropertyRoleTemplate {
  id               String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                           @map("tenant_id") @db.Uuid
  propertyId       String                           @map("property_id") @db.Uuid
  name             String                           @db.VarChar(100)
  kind             PropertyRoleTemplateKind
  createdAt        DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property         Property                         @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  capabilities     PropertyRoleTemplateCapability[]
  staffAssignments PropertyStaffAssignment[]

  @@unique([tenantId, propertyId, id])
  @@unique([tenantId, propertyId, name])
  @@index([tenantId, propertyId])
  @@map("property_role_templates")
}

model PropertyRoleTemplateCapability {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  propertyId     String               @map("property_id") @db.Uuid
  roleTemplateId String               @map("role_template_id") @db.Uuid
  capabilityId   String               @map("capability_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  roleTemplate   PropertyRoleTemplate @relation(fields: [tenantId, propertyId, roleTemplateId], references: [tenantId, propertyId, id], onDelete: Restrict, map: "property_role_template_capabilities_role_template_fkey")
  capability     Capability           @relation(fields: [tenantId, capabilityId], references: [tenantId, id], onDelete: Restrict, map: "property_role_template_capabilities_capability_fkey")

  @@unique([tenantId, propertyId, roleTemplateId, capabilityId], map: "property_role_template_capabilities_tenant_id_property_id_role_")
  @@index([tenantId, propertyId])
  @@map("property_role_template_capabilities")
}

model PropertyStaffAssignment {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  propertyId     String               @map("property_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  roleTemplateId String               @map("role_template_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       Property             @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict, map: "property_staff_assignments_property_fkey")
  membership     TenantMembership     @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Restrict, map: "property_staff_assignments_membership_fkey")
  roleTemplate   PropertyRoleTemplate @relation(fields: [tenantId, propertyId, roleTemplateId], references: [tenantId, propertyId, id], onDelete: Restrict, map: "property_staff_assignments_role_template_fkey")

  @@unique([tenantId, propertyId, userId])
  @@index([tenantId, userId])
  @@map("property_staff_assignments")
}

model PropertyStaffCapabilityOverride {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  capabilityId String   @map("capability_id") @db.Uuid
  granted      Boolean
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, propertyId, userId, capabilityId])
  @@index([tenantId, propertyId, userId])
  @@map("property_staff_capability_overrides")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  propertyId  String?  @map("property_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorType   AuditActorType @default(TENANT_USER) @map("actor_type")
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(100)
  targetId    String   @map("target_id") @db.VarChar(320)
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  type       String   @db.VarChar(100)
  payload    Json     @default("{}")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  property   Property @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, propertyId, createdAt])
  @@index([tenantId, propertyId, readAt])
  @@map("notifications")
}

model RoomType {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  propertyId       String            @map("property_id") @db.Uuid
  name             String            @db.VarChar(200)
  description      String?
  amenitiesIntro   String?           @map("amenities_intro")
  mainImageUrl     String?           @map("main_image_url") @db.VarChar(2000)
  galleryImageUrls String[]          @default([]) @map("gallery_image_urls") @db.VarChar(2000)
  maxOccupancy     Int               @map("max_occupancy")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property         Property          @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  rooms            Room[]
  rateRules        RateRule[]
  amenities        RoomTypeAmenity[]
  inventoryUnits   InventoryUnit[]
  bookings         Booking[]

  @@unique([tenantId, propertyId, id])
  @@unique([tenantId, propertyId, name])
  @@index([tenantId, propertyId])
  @@map("room_types")
}

model RoomTypeImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  roomTypeId String   @map("room_type_id") @db.Uuid
  objectKey  String   @map("object_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, propertyId, roomTypeId, objectKey])
  @@map("room_type_images")
}

model Room {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  roomTypeId     String   @map("room_type_id") @db.Uuid
  name           String   @db.VarChar(200)
  title          String?  @db.VarChar(200)
  roomSize       String?  @map("room_size") @db.VarChar(50)
  rules          String?  @db.Text
  description    String?  @db.Text
  floor          Int?
  viewType       String?  @map("view_type") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       Property @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  roomType       RoomType @relation(fields: [tenantId, propertyId, roomTypeId], references: [tenantId, propertyId, id], onDelete: Restrict)
  availability RoomAvailability[]
  priceOverrides RoomPriceOverride[]
  bookings Booking[]
  amenities RoomAmenity[]

  @@unique([tenantId, propertyId, id])
  @@unique([tenantId, propertyId, name])
  @@index([tenantId, propertyId, roomTypeId])
  @@map("rooms")
}

model RoomAvailability {
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  staysOn    DateTime @map("stays_on") @db.Date
  isAvailable Boolean @default(true) @map("is_available")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property   Property @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  room       Room     @relation(fields: [tenantId, propertyId, roomId], references: [tenantId, propertyId, id], onDelete: Restrict)

  @@id([tenantId, propertyId, roomId, staysOn])
  @@index([tenantId, propertyId, roomId, staysOn])
  @@map("room_availability")
}

model AvailabilityBlock {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  startsOn   DateTime @map("starts_on") @db.Date
  endsOn     DateTime @map("ends_on") @db.Date
  blocksAll  Boolean  @default(false) @map("blocks_all")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, propertyId, id])
  @@index([tenantId, propertyId, startsOn, endsOn])
  @@map("availability_blocks")
}

model AvailabilityBlockRoomType {
  tenantId   String @map("tenant_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  blockId    String @map("block_id") @db.Uuid
  roomTypeId String @map("room_type_id") @db.Uuid

  @@id([tenantId, propertyId, blockId, roomTypeId])
  @@index([tenantId, propertyId, roomTypeId])
  @@map("availability_block_room_types")
}

model AvailabilityBlockRoom {
  tenantId   String @map("tenant_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  blockId    String @map("block_id") @db.Uuid
  roomId     String @map("room_id") @db.Uuid

  @@id([tenantId, propertyId, blockId, roomId])
  @@index([tenantId, propertyId, roomId])
  @@map("availability_block_rooms")
}

model InventoryUnit {
  tenantId       String   @map("tenant_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  roomTypeId     String   @map("room_type_id") @db.Uuid
  staysOn        DateTime @map("stays_on") @db.Date
  availableUnits Int      @map("available_units")
  bookedUnits    Int      @default(0) @map("booked_units")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       Property @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  roomType       RoomType @relation(fields: [tenantId, propertyId, roomTypeId], references: [tenantId, propertyId, id], onDelete: Restrict)

  @@id([tenantId, propertyId, roomTypeId, staysOn])
  @@index([tenantId, propertyId, roomTypeId, staysOn])
  @@map("inventory_units")
}

model RatePlan {
  id                         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String     @map("tenant_id") @db.Uuid
  propertyId                 String     @map("property_id") @db.Uuid
  name                       String     @db.VarChar(200)
  currency                   String     @db.Char(3)
  isActive                   Boolean    @default(true) @map("is_active")
  freeCancellationUntilHours Int?       @map("free_cancellation_until_hours")
  // Non-null only for an auto-created "shadow" rate plan backing a
  // confirmed Clock ROOM_TYPE mapping — never staff-visible/selectable,
  // exists only so a Clock-priced booking still has a valid rate_plan_id
  // (also the cancellation-policy carrier) without a manual local rate plan.
  clockShadowRoomTypeId      String?    @map("clock_shadow_room_type_id") @db.Uuid
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property                   Property   @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  rules                      RateRule[]
  roomPriceOverrides         RoomPriceOverride[]
  bookings                   Booking[]

  @@unique([tenantId, propertyId, id])
  @@unique([tenantId, propertyId, name])
  @@index([tenantId, propertyId])
  @@map("rate_plans")
}

model RateRule {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  ratePlanId String    @map("rate_plan_id") @db.Uuid
  roomTypeId String    @map("room_type_id") @db.Uuid
  startsOn   DateTime? @map("starts_on") @db.Date
  endsOn     DateTime? @map("ends_on") @db.Date
  weekdays   Int[]     @default([0, 1, 2, 3, 4, 5, 6]) @db.SmallInt
  amount     Decimal   @db.Decimal(12, 2)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property   Property  @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  ratePlan   RatePlan  @relation(fields: [tenantId, propertyId, ratePlanId], references: [tenantId, propertyId, id], onDelete: Restrict)
  roomType   RoomType  @relation(fields: [tenantId, propertyId, roomTypeId], references: [tenantId, propertyId, id], onDelete: Restrict)

  @@unique([tenantId, propertyId, id])
  @@index([tenantId, propertyId, ratePlanId])
  @@index([tenantId, propertyId, roomTypeId, startsOn, endsOn])
  @@map("rate_rules")
}

model RoomPriceOverride {
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  ratePlanId String   @map("rate_plan_id") @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property   Property @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  ratePlan   RatePlan @relation(fields: [tenantId, propertyId, ratePlanId], references: [tenantId, propertyId, id], onDelete: Restrict)
  room       Room     @relation(fields: [tenantId, propertyId, roomId], references: [tenantId, propertyId, id], onDelete: Restrict)

  @@id([tenantId, propertyId, ratePlanId, roomId])
  @@index([tenantId, propertyId, roomId])
  @@map("room_price_overrides")
}

model Booking {
  id                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String        @map("tenant_id") @db.Uuid
  propertyId                 String        @map("property_id") @db.Uuid
  roomTypeId                 String        @map("room_type_id") @db.Uuid
  roomId                     String?       @map("room_id") @db.Uuid
  guestId                    String?       @map("guest_id") @db.Uuid
  guestSessionId             String?       @map("guest_session_id") @db.Uuid
  guestReturnUrl             String?       @map("guest_return_url") @db.VarChar(2000)
  specialRequests            String?       @map("special_requests") @db.VarChar(2000)
  externalReference          String        @map("external_reference") @db.VarChar(200)
  externalBookingId          String?       @map("external_booking_id") @db.VarChar(64)
  status                     BookingStatus @default(DRAFT)
  paymentMethod              BookingPaymentMethod @default(STRIPE_CHECKOUT) @map("payment_method")
  startsOn                   DateTime      @map("starts_on") @db.Date
  endsOn                     DateTime      @map("ends_on") @db.Date
  ratePlanId                 String        @map("rate_plan_id") @db.Uuid
  totalAmount                Decimal       @map("total_amount") @db.Decimal(12, 2)
  version                    Int           @default(1)
  cancellationIsFree         Boolean?      @map("cancellation_is_free")
  cancellationFreeUntilHours Int?          @map("cancellation_free_until_hours")
  cancellationCutoffAt       DateTime?     @map("cancellation_cutoff_at") @db.Timestamptz(6)
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  property                   Property      @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  roomType                   RoomType      @relation(fields: [tenantId, propertyId, roomTypeId], references: [tenantId, propertyId, id], onDelete: Restrict)
  room                       Room?         @relation(fields: [tenantId, propertyId, roomId], references: [tenantId, propertyId, id], onDelete: Restrict)
  ratePlan                   RatePlan      @relation(fields: [tenantId, propertyId, ratePlanId], references: [tenantId, propertyId, id], onDelete: Restrict)
  payments                   Payment[]
  paymentProviderSessions    PaymentProviderSession[]

  @@unique([tenantId, propertyId, id])
  @@unique([tenantId, propertyId, externalReference])
  @@index([tenantId, propertyId, status])
  @@index([tenantId, propertyId, roomTypeId, startsOn, endsOn])
  @@index([tenantId, propertyId, roomId, startsOn, endsOn])
  @@index([tenantId, propertyId, guestId])
  @@index([tenantId, propertyId, externalBookingId])
  @@map("bookings")
}

model Payment {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  propertyId        String      @map("property_id") @db.Uuid
  bookingId         String      @map("booking_id") @db.Uuid
  kind              PaymentKind
  provider          String      @db.VarChar(50)
  method            String?     @db.VarChar(50)
  externalPaymentId String      @map("external_payment_id") @db.VarChar(320)
  status            String      @db.VarChar(32)
  amount            Decimal     @db.Decimal(12, 2)
  currency          String      @db.VarChar(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  property          Property    @relation(fields: [tenantId, propertyId], references: [tenantId, id], onDelete: Restrict)
  booking           Booking     @relation(fields: [tenantId, propertyId, bookingId], references: [tenantId, propertyId, id], onDelete: Restrict)

  @@unique([tenantId, externalPaymentId])
  @@index([tenantId, propertyId, bookingId, createdAt])
  @@map("payments")
}

model PaymentProviderSession {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  propertyId        String   @map("property_id") @db.Uuid
  bookingId         String   @map("booking_id") @db.Uuid
