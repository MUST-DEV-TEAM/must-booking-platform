---
import BookingWidget from './BookingWidget.astro';
interface Props {
  tenant: string;
  venue: string;
}
const { tenant, venue } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Slow evenings, seasonal plates and a table by the sea. Reserve your place at Olive & Tide."
    />
    <title>Olive & Tide — A place at our table</title>
  </head>
  <body>
    <div class="demo-banner">
      A restaurant website demo · Reservations connect to the local MUST restaurant
    </div>
    <header>
      <a class="brand" href="#">
        olive <span>&</span> tide<small>THE MEDITERRANEAN TABLE</small>
      </a>
      <nav aria-label="Main">
        <a href="#story">Our story</a>
        <a href="#menu">On the menu</a>
        <a class="button" href="#reserve">
          Reserve a table ↗
        </a>
      </nav>
    </header>
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">GOOD FOOD. SALT AIR. NO HURRY.</p>
          <h1>
            Stay a little
            <br />
            <em>longer.</em>
          </h1>
          <p>
            Seasonal plates made to share. A glass worth lingering over. And a place at our table,
            just for you.
          </p>
          <a href="#reserve" class="button">
            Find your table <span>↗</span>
          </a>
          <p class="caption">From the first light to the last toast.</p>
        </div>
        <div class="hero-image" role="img" aria-label="A warmly lit Mediterranean restaurant">
          <div class="photo-note">
            Around the table.
            <br />
            <em>By the sea.</em>
          </div>
        </div>
      </section>
      <section id="story" class="story">
        <p class="eyebrow">SIMPLE THINGS, DONE WITH CARE</p>
        <h2>
          Come for dinner.
          <br />
          <em>Make an evening of it.</em>
        </h2>
        <p>
          We cook with the season and pour with a generous hand. Gather your favourite people,
          settle into a corner, and let the evening take its time.
        </p>
      </section>
      <section id="menu" class="menu">
        <div>
          <p class="eyebrow">A TASTE OF THE COAST</p>
          <h2>
            Made for
            <br />
            <em>the middle of the table.</em>
          </h2>
        </div>
        <div class="menu-items">
          <article>
            <h3>Burrata & summer tomatoes</h3>
            <p>Basil oil, garden herbs, toasted sourdough</p>
            <span>14</span>
          </article>
          <article>
            <h3>Catch of the day</h3>
            <p>Wood-fired, lemon, greens from the market</p>
            <span>26</span>
          </article>
          <article>
            <h3>Lemon & olive oil cake</h3>
            <p>Thick yoghurt, a little sea salt</p>
            <span>8</span>
          </article>
          <small>Sample menu · Prices in EUR</small>
        </div>
      </section>
      <section id="reserve" class="reserve">
        <div class="reserve-intro">
          <p class="eyebrow">WE'LL SAVE YOU A SEAT</p>
          <h2>
            Your next
            <br />
            <em>good evening.</em>
          </h2>
          <p>Choose your day and who’s coming. We’ll show you the tables we can welcome you to.</p>
          <div class="connection">
            <span class="dot"></span>
            <span id="restaurant-name">Connecting to the restaurant…</span>
          </div>
          <p class="caption">Availability and bookings are managed by MUST.</p>
        </div>
        <BookingWidget {tenant} {venue} />
      </section>
    </main>
    <footer>
      <a class="brand" href="#">
        olive <span>&</span> tide
      </a>
      <p>Good company. A full table. The sea nearby.</p>
      <a href="#reserve">See you at the table ↗</a>
    </footer>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 24px;
  }
  :global(body) {
    margin: 0;
    background: #f6f3eb;
    color: #253b30;
    font:
      16px/1.6 Arial,
      sans-serif;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  :global(button),
  :global(input),
  :global(select),
  :global(textarea) {
    font: inherit;
  }
  :global(button),
  :global(a),
  :global(input),
  :global(select),
  :global(textarea) {
    outline-offset: 5px;
  }
  :global([hidden]) {
    display: none !important;
  }
  .demo-banner {
    text-align: center;
    background: #253b30;
    color: #f6f3eb;
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 8px 16px;
  }
  header,
  footer {
    max-width: 1440px;
    margin: auto;
    padding: 28px 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    font:
      34px Georgia,
      serif;
    letter-spacing: -1.5px;
  }
  .brand span {
    font-style: italic;
    color: #a16a48;
  }
  .brand small {
    display: block;
    font:
      9px Arial,
      sans-serif;
    letter-spacing: 3px;
    margin-top: 8px;
  }
  nav {
    display: flex;
    gap: 34px;
    align-items: center;
    font-size: 13px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 15px 24px;
    background: #294a37;
    color: #fff;
    border: 0;
    border-radius: 3px;
    cursor: pointer;
    font-size: 14px;
  }
  .button:hover {
    background: #3b5e49;
  }
  .hero {
    max-width: 1440px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    min-height: 660px;
    padding: 20px 6% 70px;
    gap: 7%;
  }
  .hero-copy {
    padding-top: 65px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 2.6px;
    font-weight: 600;
  }
  h1,
  h2 {
    font:
      normal clamp(55px, 6.5vw, 98px)/1.04 Georgia,
      serif;
    letter-spacing: -3px;
    margin: 27px 0;
  }
  h1 em,
  h2 em {
    font-weight: normal;
    color: #9c6547;
  }
  .hero-copy > p:not(.eyebrow) {
    max-width: 350px;
    font-size: 15px;
    color: #677065;
  }
  .hero-copy .button {
    margin-top: 22px;
  }
  .caption {
    font-size: 11px !important;
    margin-top: 22px;
    color: #758076;
  }
  .hero-image {
    min-height: 580px;
    background:
      linear-gradient(180deg, transparent 45%, #1d342bdd),
      url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1100&q=85')
        center/cover,
      #66715b;
    border-radius: 180px 180px 3px 3px;
    position: relative;
  }
  .photo-note {
    position: absolute;
    bottom: 35px;
    left: 35px;
    color: #fff;
    font:
      32px/1.1 Georgia,
      serif;
  }
  .photo-note em {
    font-size: 25px;
  }
  .story {
    border-top: 1px solid #dcded0;
    text-align: center;
    padding: 90px 20px;
    max-width: 1120px;
    margin: auto;
  }
  .story h2 {
    font-size: 54px;
    letter-spacing: -1.5px;
  }
  .story > p:last-child {
    max-width: 480px;
    margin: auto;
    color: #697265;
    font-size: 14px;
  }
  .menu {
    background: #e9ecdf;
    padding: 75px max(6%, calc((100vw - 1260px) / 2));
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 10%;
  }
  .menu h2 {
    font-size: 42px;
    letter-spacing: -1px;
  }
  .menu-items article {
    position: relative;
    border-bottom: 1px solid #cbd0bd;
    padding: 15px 35px 18px 0;
  }
  .menu-items h3 {
    font:
      21px Georgia,
      serif;
    margin: 0;
  }
  .menu-items p {
    margin: 4px 0;
    color: #6b7365;
    font-size: 12px;
  }
  .menu-items span {
    position: absolute;
    right: 0;
    top: 15px;
    font:
      20px Georgia,
      serif;
  }
  .menu-items small {
    display: block;
    font-size: 10px;
    margin-top: 15px;
  }
  .reserve {
    max-width: 1250px;
    margin: auto;
    padding: 100px 6%;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 12%;
  }
  .reserve h2 {
    font-size: 62px;
  }
  .reserve-intro > p {
    color: #6b7365;
    font-size: 14px;
  }
  .connection {
    display: flex;
    gap: 9px;
    align-items: center;
    font-size: 12px;
    margin-top: 30px;
  }
  .dot {
    width: 7px;
    height: 7px;
    background: #78906a;
    border-radius: 50%;
  }
  footer {
    border-top: 1px solid #dcded0;
    font-size: 11px;
    padding-top: 38px;
    padding-bottom: 38px;
  }
  footer .brand {
    font-size: 28px;
  }
  @media (max-width: 760px) {
    header {
      padding: 24px 6%;
    }
    nav > a:not(.button) {
      display: none;
    }
    nav .button {
      padding: 12px;
      font-size: 11px;
    }
    .brand {
      font-size: 27px;
    }
    .brand small {
      font-size: 7px;
      letter-spacing: 2px;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-bottom: 45px;
    }
    .hero-copy {
      padding-top: 20px;
    }
    h1 {
      font-size: 72px;
    }
    .hero-image {
      min-height: 420px;
      border-radius: 130px 130px 3px 3px;
    }
    .story {
      padding: 55px 7%;
    }
    .story h2 {
      font-size: 40px;
    }
    .menu {
      grid-template-columns: 1fr;
      padding: 45px 7%;
      gap: 10px;
    }
    .reserve {
      grid-template-columns: 1fr;
      padding: 55px 6%;
      gap: 25px;
    }
    .reserve h2 {
      font-size: 50px;
    }
    footer {
      flex-wrap: wrap;
    }
    footer p {
      width: 100%;
      order: 3;
      margin: 0;
    }
    .demo-banner {
      font-size: 9px;
    }
  }
</style>
