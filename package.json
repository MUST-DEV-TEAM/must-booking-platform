{
  "name": "must-booking-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "lint": "eslint .",
    "lint:wordpress-plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/wordpress-plugin/tools/lint-php.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive run test",
    "e2e": "pnpm --filter web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.0"
  }
}
