# Copy to /etc/must-booking/backup.env (chmod 600). Read by the backup and restore-test units.
# No secrets go in this file: rclone keeps the storage key and crypt passwords in its own config.

# Where the encrypted dumps go. Switching the destination is this one line.
# Today (stopgap): crypt over Google Drive.
BACKUP_REMOTE=must-backup-crypt:postgres
# Professional destination (issue #370): crypt over an S3-compatible bucket, see README section 3b.
# BACKUP_REMOTE=must-backup-s3-crypt:postgres

PG_CONTAINER=must-booking-postgres-1

# Optional, defaults shown.
# LOCAL_KEEP_DAYS=7
# REMOTE_KEEP_DAYS=30
# RESTORE_TEST_DB=must_booking_restore_test
# RESTORE_MAX_AGE_HOURS=36
