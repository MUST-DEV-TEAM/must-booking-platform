# Copy to .env next to compose.homelab.yaml on the homelab host and fill in real values.
# Never commit the real .env file.

# Postgres superuser/owner role. Used directly for migrations (MIGRATION_DATABASE_URL)
# and to create the app's runtime role.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public origin for the web app (fronted by nginx-proxy-manager + Cloudflare Tunnel);
# used to build links in emails. Use the Tailscale IP:port instead if not yet fronted.
WEB_APP_URL=https://must.dejvis.dev

# HMAC key for short-lived, session-bound booking quote snapshots.
QUOTE_SIGNING_SECRET=replace-with-a-long-random-secret

# Optional: leave unset to run without transactional email / a seeded platform admin.
RESEND_API_KEY=
MAIL_FROM_EMAIL=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Optional: leave both unset to skip the post-deploy Cloudflare cache purge
# (deploy.sh still works, it just won't clear stale edge-cached pages).
# Token scope: Zone > Cache Purge > Purge, restricted to this one zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
