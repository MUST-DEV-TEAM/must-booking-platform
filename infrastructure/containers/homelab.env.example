# Copy to .env next to compose.homelab.yaml on the homelab host and fill in real values.
# Never commit the real .env file.

# Postgres superuser/owner role. Used directly for migrations (MIGRATION_DATABASE_URL)
# and to create the app's runtime role.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public origin for the web app (fronted by nginx-proxy-manager + Cloudflare Tunnel);
# used to build links in emails. Use the Tailscale IP:port instead if not yet fronted.
WEB_APP_URL=https://must.dejvis.dev

# HMAC key for short-lived, session-bound booking quote snapshots.
QUOTE_SIGNING_SECRET=replace-with-a-long-random-secret

# AES-256-GCM master key (32 bytes, base64) for tenant-owned integration
# connection credentials at rest (ADR-0026, Milestone 11). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must differ from any per-developer local .env value.
INTEGRATION_CREDENTIALS_KEY=replace-with-a-generated-32-byte-base64-key

# Required for real operational alerts. Create a production Sentry project and
# put its DSN here; deploy-drift checks and API/Clock failures use this same one.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# apps/web (Next.js) uses a separate Sentry project from the api/deploy-webhook
# SENTRY_DSN above -- do not reuse that value here.
WEB_SENTRY_DSN=
# Optional: only needed to upload source maps during the web build (readable stack
# traces in prod). Org/project slugs, not the numeric IDs embedded in the DSN.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# The persistent deploy webhook must run git as this dedicated, non-root host
# account. Set DOCKER_GID to `stat -c '%g' /var/run/docker.sock` so it can run
# compose without becoming root. The checkout must be owned by DEPLOY_UID:GID.
DEPLOY_UID=
DEPLOY_GID=
DOCKER_GID=

# Install must-booking-deploy-drift.service and .timer on the host after
# replacing their /srv/must-booking path/User/Group with this checkout and
# deploy account. `systemctl enable --now must-booking-deploy-drift.timer`
# then runs the same commit check every five minutes, including after reboots.

# Optional: leave unset to run without transactional email / a seeded platform admin.
RESEND_API_KEY=
MAIL_FROM_EMAIL=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Optional: leave both unset to skip the post-deploy Cloudflare cache purge
# (deploy.sh still works, it just won't clear stale edge-cached pages).
# Token scope: Zone > Cache Purge > Purge, restricted to this one zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
